---
import SkiBuddies from './SkiBuddies.astro';
import { me } from '../data/site';
---

<header class="hero">
  <div class="words">
    <h1>Hi, I'm {me.name.split(' ')[0]}.</h1>
    <p>{me.tagline}</p>
  </div>
  <SkiBuddies />
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 15rem;
    align-items: center;
    gap: 1.5rem;
    margin: 3.5rem 0 4rem;
  }

  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }

  p {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 24rem;
    margin: 0;
  }

  /* On phones the friends stand above the words. */
  @media (max-width: 40rem) {
    .hero {
      grid-template-columns: 1fr;
      margin: 2rem 0 3rem;
    }
    .hero :global(.buddies) {
      order: -1;
      max-width: 12rem;
    }
  }
</style>

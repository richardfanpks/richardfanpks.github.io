---
// The band between the two pages: the night sky fades through dawn into the cream research page.
// It's opaque, so the mountains and falling snow slide away behind it as you scroll.
---

<div class="daybreak" aria-hidden="true">
  <svg class="hills" viewBox="0 0 1440 160" preserveAspectRatio="none">
    <path fill="#f1e2d3" d="M0 90 Q200 30 420 80 T860 70 T1440 60 L1440 160 L0 160 Z" />
    <g fill="#d9c7b6">
      <path d="M300 74 l10 -26 l10 26 z M322 76 l7 -18 l7 18 z M1080 66 l11 -28 l11 28 z M1104 68 l7 -18 l7 18 z" />
    </g>
    <path fill="var(--cream)" d="M0 130 Q360 90 760 120 T1440 110 L1440 160 L0 160 Z" />
  </svg>
</div>

<style>
  .daybreak {
    position: relative;
    height: clamp(18rem, 55vh, 30rem);
    margin-top: 5rem;
    background: linear-gradient(
      to bottom,
      var(--snow) 0%,
      #2b3a62 28%,
      #6f7aa6 52%,
      #d9b8b8 74%,
      #f4ddcc 92%
    );
  }

  .hills {
    position: absolute;
    inset: auto 0 -1px 0;
    width: 100%;
    height: 9rem;
  }
</style>

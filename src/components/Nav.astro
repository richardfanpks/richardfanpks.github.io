---
// Links to each section of the page.
const links = [
  { href: '#about', label: 'About' },
  { href: '#research', label: 'Research' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<nav aria-label="Sections">
  <a class="home" href="/" aria-label="Richard Fan, home">rf</a>
  <ul>
    {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .home {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--red);
    color: #ffffff;
    font-family: var(--display);
    font-weight: 700;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }

  @media (max-width: 26rem) {
    ul { gap: 0.25rem 0.9rem; font-size: 0.95rem; }
  }

  ul a:hover { text-decoration: underline; text-decoration-color: var(--red); }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skiing from '../components/Skiing.astro';
import Elsewhere from '../components/Elsewhere.astro';
import Daybreak from '../components/Daybreak.astro';
import ResearchPage from '../components/ResearchPage.astro';
import { projects } from '../data/projects';
---

<BaseLayout>
  <!-- Page one: a night on the slopes -->
  <div class="wrap">
    <Hero />
    <div class="sections">
      <About />
      <Projects id="projects" title="Projects" items={projects} />
      <Skiing />
      <Elsewhere />
    </div>
  </div>

  <!-- Scroll down into page two: research in a snowy forest by day -->
  <Daybreak />
  <ResearchPage />
</BaseLayout>

<style>
  .sections {
    display: grid;
    gap: 3.5rem;
  }
</style>

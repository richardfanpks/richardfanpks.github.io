---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skiing from '../components/Skiing.astro';
import Elsewhere from '../components/Elsewhere.astro';
import Contact from '../components/Contact.astro';
import { research, projects } from '../data/projects';
---

<BaseLayout>
  <Hero />
  <div class="sections">
    <About />
    <Projects id="research" title="Research" items={research} />
    <Projects id="projects" title="Projects" items={projects} />
    <Skiing />
    <Elsewhere />
    <Contact />
  </div>
</BaseLayout>

<style>
  .sections {
    display: grid;
    gap: 3.5rem;
  }
</style>

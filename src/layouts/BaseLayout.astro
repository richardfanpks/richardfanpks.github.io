---
// The frame every page shares: fonts, global styles, the night background and the nav.
import '@fontsource-variable/shantell-sans';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Mountains from '../components/Mountains.astro';
import Snowfall from '../components/Snowfall.astro';
import { me } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = me.name, description = me.tagline } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Mountains />
    <Snowfall />
    <div class="page">
      <div class="wrap"><Nav /></div>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    position: relative;
    z-index: 1;
    padding-top: 1.5rem;
  }
</style>
